# Model provider settings
MODEL_PROVIDER=gemini        # "gemini", "openai", "deepseek", or "mock"
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

CRITIC_MODEL_NAME=gemini-1.5-pro
REDTEAM_MODEL_NAME=gemini-1.5-pro
UTILITY_MODEL_NAME=gemini-1.5-flash

# Retrieval APIs
ARXIV_API_BASE=http://export.arxiv.org/api/query
PMC_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi

# Application configuration
DATABASE_URL=sqlite:///./cie.db
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Cost accounting rates (USD per 1K tokens)
INPUT_TOKEN_COST_PER_1K=0.00025
OUTPUT_TOKEN_COST_PER_1K=0.00075
